;; Canon de la capacidad Ventas (prototipo ampliado, D81).
;;
;; Etapa 7: el cliente y sus datos maestros. Crear, modificar y desactivar una
;; entidad (M1). Las operaciones reciben además los campos propios que la
;; empresa agrega al cliente (D3), porque declaran `:op/entidad`.
;;
;; Etapa 8: el pedido. Abre la entrega pendiente y el cobro latente, que activará
;; la factura. El cupo disponible es un concepto (H3).
;;
;; Etapa 9: despachar (un hecho reduce la entrega y la reserva, T9, con costo de
;; un cálculo algorítmico), facturar, cobrar varias facturas con un pago (T9),
;; vender en mesón (hecho compuesto, D62) y revertir una factura con una nota de
;; crédito (D16).
;;
;; Etapa 10: la factura recibe IVA, folio y cuentas como entradas opcionales, que
;; llenan políticas (legales o de la empresa); el contrato no conoce la ley. Su
;; asiento va dentro del hecho, así que una nota de crédito lo revierte. El envío
;; al SII pasa por un puerto (`:op/impl`) que atiende una implementación
;; registrada. Lo que se cobra se abre por el total, con IVA.

{:entidades
 [{:entidad/tipo   :cliente
   :entidad/campos {:cliente/nombre :texto
                    :cliente/cupo   :monto}
   :entidad/extensible true}]

 :tipos-hecho
 [{:tipo-hecho/id      :ventas/pedido
   :tipo-hecho/datos   [:map
                        [:cliente [:ref :cliente]]
                        [:producto [:ref :producto]]
                        [:cantidad :cantidad]
                        [:precio-unitario :monto]]
   :tipo-hecho/regimen :solo-agregar}

  {:tipo-hecho/id      :ventas/despacho
   :tipo-hecho/datos   [:map
                        [:entrega {:optional true} [:ref :ventas/entrega-pendiente]]
                        [:producto [:ref :producto]]
                        [:bodega [:ref :bodega]]
                        [:cantidad :cantidad]
                        [:costo-unitario :monto]]
   :tipo-hecho/regimen :solo-agregar
   :tipo-hecho/mueve   [{:saldo :inventario/existencia
                         :clave {:producto hecho/producto :bodega hecho/bodega}
                         :suma  {:cantidad [:* -1 hecho/cantidad]
                                 :costo    [:* -1 hecho/cantidad hecho/costo-unitario]}}]}

  {:tipo-hecho/id      :ventas/factura
   :tipo-hecho/datos   [:map
                        [:pedido [:ref :ventas/pedido]]
                        [:monto :monto]
                        [:iva {:optional true} :monto]
                        [:folio {:optional true} :cantidad]
                        [:fecha :fecha]
                        [:vencimiento :fecha]
                        [:envio {:optional true} :string]
                        [:asiento {:optional true} [:map-of :keyword :any]]]
   :tipo-hecho/regimen :solo-agregar
   :tipo-hecho/mueve   [{:saldo :ventas/facturado
                         :clave {:cliente [:-> hecho/pedido :hecho/datos :cliente]}
                         :suma  {:monto hecho/monto}}
                        ;; Cada línea del asiento mueve el saldo de su cuenta.
                        {:saldo :contabilidad/cuenta
                         :cada  hecho/asiento
                         :clave {:cuenta cada/cuenta}
                         :suma  {:debe cada/debe :haber cada/haber}}]}

  {:tipo-hecho/id      :ventas/nota-credito
   :tipo-hecho/datos   [:map
                        [:factura [:ref :ventas/factura]]
                        [:monto :monto]
                        [:fecha :fecha]]
   :tipo-hecho/regimen :solo-agregar}

  {:tipo-hecho/id      :ventas/cobro
   :tipo-hecho/datos   [:map
                        [:cliente [:ref :cliente]]
                        [:monto :monto]]
   :tipo-hecho/regimen :solo-agregar}

  {:tipo-hecho/id      :ventas/boleta
   :tipo-hecho/datos   [:map
                        [:producto [:ref :producto]]
                        [:cantidad :cantidad]
                        [:precio-unitario :monto]
                        [:monto :monto]]
   :tipo-hecho/regimen :solo-agregar}

  {:tipo-hecho/id      :ventas/cobro-contado
   :tipo-hecho/datos   [:map [:monto :monto]]
   :tipo-hecho/regimen :solo-agregar}]

 :conceptos
 [;; Lo que le queda al cliente de su cupo: el cupo menos lo que debe o deberá.
  {:concepto/id      :credito/cupo-disponible
   :concepto/version 1
   :concepto/tipo    :monto
   :concepto/params  {:cliente :ref}
   :concepto/forma   [:- [:-> cliente :cliente/cupo]
                         [:suma [:si [:= [:-> cada :compromiso/estado] :extinguido]
                                     0
                                     [:-> cada :compromiso/saldo :monto]]
                                [:compromisos {:tipo :ventas/por-cobrar :deudor cliente}]]]}]

 :contratos
 [{:op/id        :ventas/alta-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entidad   :cliente
   :op/entradas  [:map
                  [:id :keyword]
                  [:nombre :texto]
                  [:cupo {:optional true} :monto]]
   :op/salidas   {:cliente cliente/id}
   :op/efectos
   [[:crea-entidad :cliente {:id             entrada/id
                             :cliente/nombre entrada/nombre
                             :cliente/cupo   entrada/cupo}
     :como cliente]]}

  {:op/id        :ventas/modificar-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entidad   :cliente
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:nombre {:optional true} :texto]
                  [:cupo {:optional true} :monto]]
   :op/salidas   {:cliente entrada/cliente}
   :op/efectos
   [[:modifica-entidad entrada/cliente {:cliente/nombre entrada/nombre
                                        :cliente/cupo   entrada/cupo}]]}

  {:op/id        :ventas/desactivar-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]]
   :op/salidas   {:cliente entrada/cliente}
   :op/efectos
   [[:desactiva-entidad entrada/cliente]]}

  {:op/id        :ventas/registrar-pedido
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:producto [:ref :producto]]
                  [:cantidad :cantidad]
                  [:precio-unitario :monto]]
   :op/salidas   {:pedido pedido/id :entrega entrega/id}
   :op/efectos
   [[:registra-hecho :ventas/pedido entrada :como pedido]
    [:abre-compromiso {:tipo     :ventas/entrega-pendiente
                       :deudor   empresa
                       :acreedor entrada/cliente
                       :origen   pedido/id
                       :objeto   {:producto entrada/producto :cantidad entrada/cantidad}}
     :como entrega]
    [:abre-compromiso {:tipo     :ventas/por-cobrar
                       :deudor   entrada/cliente
                       :acreedor empresa
                       :estado   :latente
                       :origen   pedido/id
                       :objeto   {:monto [:* entrada/cantidad entrada/precio-unitario]}}]]}

  {:op/id        :ventas/despachar
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:entrega [:ref :ventas/entrega-pendiente]]
                  [:producto [:ref :producto]]
                  [:bodega [:ref :bodega]]
                  [:cantidad :cantidad]
                  [:metodo {:optional true} :keyword]]
   :op/salidas   {:despacho despacho/id}
   :op/efectos
   [[:registra-hecho :ventas/despacho
     {:entrega        entrada/entrega
      :producto       entrada/producto
      :bodega         entrada/bodega
      :cantidad       entrada/cantidad
      :costo-unitario [:inventario/costo-unitario {:producto entrada/producto :bodega entrada/bodega
                                                   :cantidad entrada/cantidad :metodo entrada/metodo}]}
     :como despacho]
    [:reduce-compromiso entrada/entrega {:cantidad entrada/cantidad}]
    [:reduce-compromiso [:compromisos {:tipo :inventario/reservado :raiz caso/id :estado :activo}]
                        {:cantidad entrada/cantidad}]]}

  {:op/id        :ventas/emitir-factura
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/impl      :tributario/envio-dte
   :op/entradas  [:map
                  [:pedido [:ref :ventas/pedido]]
                  [:monto :monto]
                  [:fecha :fecha]
                  [:vencimiento :fecha]
                  [:iva {:optional true} :monto]
                  [:folio {:optional true} :cantidad]
                  [:cuenta-clientes {:optional true} :keyword]
                  [:cuenta-ventas {:optional true} :keyword]
                  [:cuenta-iva {:optional true} :keyword]]
   :op/salidas   {:factura factura/id :cobro cobro/id}
   :op/efectos
   [[:registra-hecho :ventas/factura
     {:pedido      entrada/pedido
      :monto       entrada/monto
      :iva         entrada/iva
      :folio       entrada/folio
      :fecha       entrada/fecha
      :vencimiento entrada/vencimiento
      :envio       impl/seguimiento
      :asiento     [:si entrada/cuenta-clientes
                    {:clientes {:cuenta entrada/cuenta-clientes
                                :debe   [:+ entrada/monto [:si entrada/iva entrada/iva 0]]
                                :haber  0}
                     :ventas   {:cuenta entrada/cuenta-ventas :debe 0 :haber entrada/monto}
                     :iva      {:cuenta entrada/cuenta-iva :debe 0 :haber [:si entrada/iva entrada/iva 0]}}
                    nil]}
     :como factura]
    [:cuando entrada/folio
     [:registra-hecho :tributario/folio-usado {:documento :factura :folio entrada/folio}]]
    [:extingue-compromiso [:compromisos {:tipo :ventas/por-cobrar :origen entrada/pedido :estado :latente}]
                          :facturado]
    [:abre-compromiso {:tipo     :ventas/por-cobrar
                       :deudor   [:-> entrada/pedido :hecho/datos :cliente]
                       :acreedor empresa
                       :vence    entrada/vencimiento
                       :origen   factura/id
                       :objeto   {:monto [:+ entrada/monto [:si entrada/iva entrada/iva 0]]}}
     :como cobro]]}

  {:op/id        :ventas/registrar-cobro
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:monto :monto]]
   :op/salidas   {:cobro cobro/id}
   :op/efectos
   [[:registra-hecho :ventas/cobro entrada :como cobro]
    [:reduce-compromiso [:compromisos {:tipo :ventas/por-cobrar :deudor entrada/cliente :acreedor empresa
                                       :estado :activo}]
                        {:monto entrada/monto}]]}

  {:op/id        :ventas/venta-mostrador
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:producto [:ref :producto]]
                  [:bodega [:ref :bodega]]
                  [:cantidad :cantidad]
                  [:precio-unitario :monto]]
   :op/salidas   {:boleta boleta/id}
   :op/efectos
   [[:registra-hecho :ventas/boleta {:producto        entrada/producto
                                     :cantidad        entrada/cantidad
                                     :precio-unitario entrada/precio-unitario
                                     :monto           [:* entrada/cantidad entrada/precio-unitario]}
     :como boleta]
    [:registra-hecho :ventas/despacho
     {:producto       entrada/producto
      :bodega         entrada/bodega
      :cantidad       entrada/cantidad
      :costo-unitario [:inventario/costo-unitario {:producto entrada/producto :bodega entrada/bodega
                                                   :cantidad entrada/cantidad :metodo nil}]}]
    [:registra-hecho :ventas/cobro-contado {:monto [:* entrada/cantidad entrada/precio-unitario]}]]}

  {:op/id        :ventas/emitir-nota-credito
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:factura [:ref :ventas/factura]]
                  [:fecha :fecha]]
   :op/salidas   {:nota nota/id}
   :op/efectos
   [[:registra-hecho :ventas/nota-credito {:factura entrada/factura
                                           :monto   [:-> entrada/factura :hecho/datos :monto]
                                           :fecha   entrada/fecha}
     :como nota]
    [:revierte-hecho entrada/factura]
    [:reduce-compromiso [:compromisos {:tipo :ventas/por-cobrar :origen entrada/factura :estado :activo}]
                        {:monto [:+ [:-> entrada/factura :hecho/datos :monto]
                                    [:si [:-> entrada/factura :hecho/datos :iva]
                                         [:-> entrada/factura :hecho/datos :iva]
                                         0]]}]]}]}
