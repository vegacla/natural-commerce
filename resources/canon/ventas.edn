;; Canon de la capacidad Ventas (prototipo ampliado, D81).
;;
;; Etapa 7: el cliente y sus datos maestros. Crear, modificar y desactivar una
;; entidad (M1). Las operaciones reciben además los campos propios que la
;; empresa agrega al cliente (D3), porque declaran `:op/entidad`.
;;
;; Etapa 8: el pedido. Abre la entrega pendiente y el cobro latente, que activará
;; la factura. El cupo disponible es un concepto (H3).

{:entidades
 [{:entidad/tipo   :cliente
   :entidad/campos {:cliente/nombre :texto
                    :cliente/cupo   :monto}
   :entidad/extensible true}]

 :tipos-hecho
 [{:tipo-hecho/id      :ventas/pedido
   :tipo-hecho/datos   [:map
                        [:cliente [:ref :cliente]]
                        [:producto [:ref :producto]]
                        [:cantidad :cantidad]
                        [:precio-unitario :monto]]
   :tipo-hecho/regimen :solo-agregar}]

 :conceptos
 [;; Lo que le queda al cliente de su cupo: el cupo menos lo que debe o deberá.
  {:concepto/id      :credito/cupo-disponible
   :concepto/version 1
   :concepto/tipo    :monto
   :concepto/params  {:cliente :ref}
   :concepto/forma   [:- [:-> cliente :cliente/cupo]
                         [:suma [:-> cada :compromiso/saldo :monto]
                                [:compromisos {:tipo :ventas/por-cobrar :deudor cliente}]]]}]

 :contratos
 [{:op/id        :ventas/alta-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entidad   :cliente
   :op/entradas  [:map
                  [:id :keyword]
                  [:nombre :texto]
                  [:cupo {:optional true} :monto]]
   :op/salidas   {:cliente cliente/id}
   :op/efectos
   [[:crea-entidad :cliente {:id             entrada/id
                             :cliente/nombre entrada/nombre
                             :cliente/cupo   entrada/cupo}
     :como cliente]]}

  {:op/id        :ventas/modificar-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entidad   :cliente
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:nombre {:optional true} :texto]
                  [:cupo {:optional true} :monto]]
   :op/salidas   {:cliente entrada/cliente}
   :op/efectos
   [[:modifica-entidad entrada/cliente {:cliente/nombre entrada/nombre
                                        :cliente/cupo   entrada/cupo}]]}

  {:op/id        :ventas/desactivar-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]]
   :op/salidas   {:cliente entrada/cliente}
   :op/efectos
   [[:desactiva-entidad entrada/cliente]]}

  {:op/id        :ventas/registrar-pedido
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:producto [:ref :producto]]
                  [:cantidad :cantidad]
                  [:precio-unitario :monto]]
   :op/salidas   {:pedido pedido/id :entrega entrega/id}
   :op/efectos
   [[:registra-hecho :ventas/pedido entrada :como pedido]
    [:abre-compromiso {:tipo     :ventas/entrega-pendiente
                       :deudor   empresa
                       :acreedor entrada/cliente
                       :origen   pedido/id
                       :objeto   {:producto entrada/producto :cantidad entrada/cantidad}}
     :como entrega]
    [:abre-compromiso {:tipo     :ventas/por-cobrar
                       :deudor   entrada/cliente
                       :acreedor empresa
                       :estado   :latente
                       :origen   pedido/id
                       :objeto   {:monto [:* entrada/cantidad entrada/precio-unitario]}}]]}]}
