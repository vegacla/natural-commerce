;; Canon de la capacidad Ventas, escrito a partir de notacion-v0.md,
;; compras.edn y descripcion-ventas.md. Las dudas y supuestos van en notas-agente.md.

{:entidades
 [{:entidad/tipo   :cliente
   :entidad/campos {:cliente/nombre :texto
                    :cliente/cupo   :monto}
   :entidad/extensible true}]

 :conceptos
 [;; Monto de una factura: neto más IVA, y neto si no hay IVA (D38, concepto propio)
  {:concepto/id         :ventas/total-factura
   :concepto/version    1
   :concepto/rige-desde #inst "2026-11-19"
   :concepto/tipo       :monto
   :concepto/params     {:monto :monto :iva :monto}
   :concepto/forma      [:+ monto [:si iva iva [:* 0 monto]]]}

  ;; Cupo menos lo exigible y lo anotado por pedidos sin facturar
  {:concepto/id         :credito/cupo-disponible
   :concepto/version    1
   :concepto/rige-desde #inst "2026-11-19"
   :concepto/tipo       :monto
   :concepto/params     {:cliente [:ref :cliente]}
   :concepto/forma      [:- [:-> cliente :cliente/cupo]
                         [:+ [:suma [:-> cada :compromiso/saldo :monto]
                                    [:compromisos {:tipo :ventas/por-cobrar :deudor cliente :estado :activo}]]
                             [:suma [:-> cada :compromiso/saldo :monto]
                                    [:compromisos {:tipo :ventas/por-cobrar :deudor cliente :estado :latente}]]]]}]

 :tipos-hecho
 [{:tipo-hecho/id      :ventas/pedido
   :tipo-hecho/datos   [:map
                        [:cliente [:ref :cliente]]
                        [:producto [:ref :producto]]
                        [:cantidad :cantidad]
                        [:precio-unitario :monto]]
   :tipo-hecho/regimen :solo-agregar}

  ;; Entrega opcional: la venta de mostrador despacha sin compromiso de entrega
  {:tipo-hecho/id      :ventas/despacho
   :tipo-hecho/datos   [:map
                        [:entrega {:optional true} [:ref :ventas/entrega-pendiente]]
                        [:producto [:ref :producto]]
                        [:bodega [:ref :bodega]]
                        [:cantidad :cantidad]
                        [:costo-unitario :monto]]
   :tipo-hecho/regimen :solo-agregar
   :tipo-hecho/mueve   [{:saldo :inventario/existencia
                         :clave {:producto hecho/producto :bodega hecho/bodega}
                         :suma  {:cantidad [:* -1 hecho/cantidad]
                                 :costo    [:* -1 [:* hecho/cantidad hecho/costo-unitario]]}}]}

  {:tipo-hecho/id      :ventas/factura
   :tipo-hecho/datos   [:map
                        [:pedido [:ref :ventas/pedido]]
                        [:monto :monto]
                        [:iva {:optional true} :monto]
                        [:folio {:optional true} :cantidad]
                        [:fecha :fecha]
                        [:vencimiento :fecha]
                        [:envio :texto]
                        [:asiento {:optional true}
                         [:map-of :keyword [:map [:cuenta :keyword] [:debe :monto] [:haber :monto]]]]]
   :tipo-hecho/regimen :solo-agregar
   :tipo-hecho/mueve   [{:saldo :ventas/facturado
                         :clave {:cliente [:-> hecho/pedido :hecho/datos :cliente]}
                         :suma  {:monto hecho/monto}}
                        {:saldo :contabilidad/cuenta
                         :cada  hecho/asiento
                         :clave {:cuenta cada/cuenta}
                         :suma  {:debe cada/debe :haber cada/haber}}]}

  {:tipo-hecho/id      :ventas/cobro
   :tipo-hecho/datos   [:map
                        [:cliente [:ref :cliente]]
                        [:monto :monto]]
   :tipo-hecho/regimen :solo-agregar}

  {:tipo-hecho/id      :ventas/boleta
   :tipo-hecho/datos   [:map
                        [:producto [:ref :producto]]
                        [:cantidad :cantidad]
                        [:precio-unitario :monto]
                        [:monto :monto]]
   :tipo-hecho/regimen :solo-agregar}

  {:tipo-hecho/id      :ventas/cobro-contado
   :tipo-hecho/datos   [:map
                        [:monto :monto]]
   :tipo-hecho/regimen :solo-agregar}

  {:tipo-hecho/id      :ventas/nota-credito
   :tipo-hecho/datos   [:map
                        [:factura [:ref :ventas/factura]]
                        [:monto :monto]
                        [:fecha :fecha]]
   :tipo-hecho/regimen :solo-agregar}]

 :contratos
 [{:op/id        :ventas/alta-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entidad   :cliente
   :op/entradas  [:map
                  [:id :keyword]
                  [:nombre :texto]
                  [:cupo {:optional true} :monto]]
   :op/salidas   {:cliente cliente/id}
   :op/efectos
   [[:crea-entidad :cliente {:id entrada/id
                             :cliente/nombre entrada/nombre
                             :cliente/cupo entrada/cupo}
     :como cliente]]}

  {:op/id        :ventas/modificar-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entidad   :cliente
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:nombre {:optional true} :texto]
                  [:cupo {:optional true} :monto]]
   :op/salidas   {:cliente entrada/cliente}
   :op/efectos
   [[:modifica-entidad entrada/cliente {:cliente/nombre entrada/nombre
                                        :cliente/cupo   entrada/cupo}]]}

  {:op/id        :ventas/desactivar-cliente
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entidad   :cliente
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]]
   :op/salidas   {:cliente entrada/cliente}
   :op/efectos
   [[:desactiva-entidad entrada/cliente]]}

  {:op/id        :ventas/registrar-pedido
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:producto [:ref :producto]]
                  [:cantidad :cantidad]
                  [:precio-unitario :monto]]
   :op/salidas   {:pedido pedido/id
                  :entrega entrega/id}
   :op/efectos
   [[:registra-hecho :ventas/pedido entrada :como pedido]
    [:abre-compromiso {:tipo     :ventas/entrega-pendiente
                       :deudor   empresa
                       :acreedor entrada/cliente
                       :origen   pedido/id
                       :objeto   {:producto entrada/producto
                                  :cantidad entrada/cantidad}}
     :como entrega]
    [:abre-compromiso {:tipo     :ventas/por-cobrar
                       :deudor   entrada/cliente
                       :acreedor empresa
                       :estado   :latente
                       :origen   pedido/id
                       :objeto   {:monto [:* entrada/cantidad entrada/precio-unitario]}}
     :como anotado]]}

  {:op/id        :ventas/despachar
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:entrega [:ref :ventas/entrega-pendiente]]
                  [:producto [:ref :producto]]
                  [:bodega [:ref :bodega]]
                  [:cantidad :cantidad]
                  [:metodo {:optional true} :keyword]]
   :op/salidas   {:despacho despacho/id}
   :op/efectos
   [[:registra-hecho :ventas/despacho
     {:entrega        entrada/entrega
      :producto       entrada/producto
      :bodega         entrada/bodega
      :cantidad       entrada/cantidad
      :costo-unitario [:inventario/costo-unitario {:producto entrada/producto
                                                   :bodega   entrada/bodega
                                                   :cantidad entrada/cantidad
                                                   :metodo   entrada/metodo}]}
     :como despacho]
    [:reduce-compromiso entrada/entrega {:cantidad entrada/cantidad}]
    [:reduce-compromiso [:compromisos {:tipo :inventario/reservado
                                       :origen entrada/entrega
                                       :estado :activo}]
                        {:cantidad entrada/cantidad}]]}

  {:op/id        :ventas/emitir-factura
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/impl      :tributario/envio-dte
   :op/entradas  [:map
                  [:pedido [:ref :ventas/pedido]]
                  [:monto :monto]
                  [:fecha :fecha]
                  [:vencimiento :fecha]
                  [:iva {:optional true} :monto]
                  [:folio {:optional true} :cantidad]
                  [:cuenta-clientes {:optional true} :keyword]
                  [:cuenta-ventas {:optional true} :keyword]
                  [:cuenta-iva {:optional true} :keyword]]
   :op/salidas   {:factura factura/id
                  :cobro   por-cobrar/id}
   :op/efectos
   [[:registra-hecho :ventas/factura
     {:pedido      entrada/pedido
      :monto       entrada/monto
      :iva         entrada/iva
      :folio       entrada/folio
      :fecha       entrada/fecha
      :vencimiento entrada/vencimiento
      :envio       impl/seguimiento
      :asiento     [:si [:y entrada/cuenta-clientes entrada/cuenta-ventas entrada/cuenta-iva]
                    {:clientes {:cuenta entrada/cuenta-clientes
                                :debe   [:ventas/total-factura {:monto entrada/monto :iva entrada/iva}]
                                :haber  [:* 0 entrada/monto]}
                     :ventas   {:cuenta entrada/cuenta-ventas
                                :debe   [:* 0 entrada/monto]
                                :haber  entrada/monto}
                     :iva      {:cuenta entrada/cuenta-iva
                                :debe   [:* 0 entrada/monto]
                                :haber  [:si entrada/iva entrada/iva [:* 0 entrada/monto]]}}
                    nil]}
     :como factura]
    [:cuando entrada/folio
     [:registra-hecho :tributario/folio-usado {:documento :factura :folio entrada/folio}]]
    [:extingue-compromiso [:compromisos {:tipo   :ventas/por-cobrar
                                         :origen entrada/pedido
                                         :estado :latente}]
     :facturado]
    [:abre-compromiso {:tipo     :ventas/por-cobrar
                       :deudor   [:-> entrada/pedido :hecho/datos :cliente]
                       :acreedor empresa
                       :estado   :activo
                       :vence    entrada/vencimiento
                       :origen   factura/id
                       :objeto   {:monto [:ventas/total-factura {:monto entrada/monto :iva entrada/iva}]}}
     :como por-cobrar]]}

  {:op/id        :ventas/registrar-cobro
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:cliente [:ref :cliente]]
                  [:monto :monto]]
   :op/salidas   {:cobro cobro/id}
   :op/efectos
   [[:registra-hecho :ventas/cobro entrada :como cobro]
    [:reduce-compromiso [:compromisos {:tipo     :ventas/por-cobrar
                                       :deudor   entrada/cliente
                                       :acreedor empresa
                                       :estado   :activo}]
                        {:monto entrada/monto}]]}

  {:op/id        :ventas/venta-mostrador
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:producto [:ref :producto]]
                  [:bodega [:ref :bodega]]
                  [:cantidad :cantidad]
                  [:precio-unitario :monto]]
   :op/salidas   {:boleta boleta/id}
   :op/efectos
   [[:registra-hecho :ventas/boleta
     {:producto        entrada/producto
      :cantidad        entrada/cantidad
      :precio-unitario entrada/precio-unitario
      :monto           [:* entrada/cantidad entrada/precio-unitario]}
     :como boleta]
    [:registra-hecho :ventas/despacho
     {:producto        entrada/producto
      :bodega          entrada/bodega
      :cantidad        entrada/cantidad
      :costo-unitario  [:inventario/costo-unitario {:producto entrada/producto
                                                    :bodega   entrada/bodega
                                                    :cantidad entrada/cantidad
                                                    :metodo   nil}]}]
    [:registra-hecho :ventas/cobro-contado
     {:monto [:* entrada/cantidad entrada/precio-unitario]}]]}

  {:op/id        :ventas/emitir-nota-credito
   :op/capacidad :ventas
   :op/tipo      :efecto
   :op/entradas  [:map
                  [:factura [:ref :ventas/factura]]
                  [:fecha :fecha]]
   :op/salidas   {:nota nota/id}
   :op/efectos
   [[:registra-hecho :ventas/nota-credito
     {:factura entrada/factura
      :monto   [:-> entrada/factura :hecho/datos :monto]
      :fecha   entrada/fecha}
     :como nota]
    [:revierte-hecho entrada/factura]
    [:reduce-compromiso [:compromisos {:tipo   :ventas/por-cobrar
                                       :origen entrada/factura
                                       :estado :activo}]
                        {:monto [:ventas/total-factura
                                 {:monto [:-> entrada/factura :hecho/datos :monto]
                                  :iva   [:-> entrada/factura :hecho/datos :iva]}]}]]}]}
