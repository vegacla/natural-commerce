{:paths ["src" "resources"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.0"}
         metosin/malli       {:mvn/version "0.20.3"}
         com.xtdb/xtdb-api   {:mvn/version "2.2.0"}
         com.xtdb/xtdb-core  {:mvn/version "2.2.0"}
         ;; SARA con LLM (etapa 12): el único lugar que habla con un modelo.
         com.anthropic/anthropic-java {:mvn/version "3.10.0"}}
 :aliases
 {;; Opciones de la JVM que exige un nodo XTDB en el mismo proceso (JDK 21).
  :xtdb {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--enable-native-access=ALL-UNNAMED"
                    "-Dio.netty.tryReflectionSetAccessible=true"
                    "-Dio.netty.noUnsafe=false"]}
  ;; SARA mínima con datos de ejemplo: deps -M:xtdb:sara [puerto]
  :sara {:main-opts ["-m" "nc.sara.web"]}
  ;; Pruebas de mutación de los resguardos, en una sola JVM: deps -M:mutaciones
  :mutaciones {:extra-paths ["test" "scripts"]
               :extra-deps  {}
               :jvm-opts    ["-Xmx768m" "-XX:MaxDirectMemorySize=512m"
                             "--add-opens=java.base/java.nio=ALL-UNNAMED"
                             "--enable-native-access=ALL-UNNAMED"
                             "-Dio.netty.tryReflectionSetAccessible=true"
                             "-Dio.netty.noUnsafe=false"]
               :main-opts   ["-m" "mutaciones"]}
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         ;; Tope de memoria: la suite usa unos 700 MB (2026-11-18). Con tope, una
         ;; corrida no compite sin límite con el resto del equipo.
         :jvm-opts    ["-Xmx768m" "-XX:MaxDirectMemorySize=512m"
                       "--add-opens=java.base/java.nio=ALL-UNNAMED"
                       "--enable-native-access=ALL-UNNAMED"
                       "-Dio.netty.tryReflectionSetAccessible=true"
                       "-Dio.netty.noUnsafe=false"]
         :main-opts   ["-m" "cognitect.test-runner"]}}}
